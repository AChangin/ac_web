        {
          "type": "text",
          "content": "全球资本主义可能进入一个越来越难以解决自身矛盾的阶段",
          "x": "657.2vw",
          "y": "0.8vh",
          "width": "75vw",
          "fontFamily": "'Inter', sans-serif",
          "fontSize": "6vw",
          "fontWeight": "500",
          "color": "#fff",
          "zIndex": 0,
          "id": "el_7j5d6mym",
          "_inspectorPushed": true,
          "marginTop": "40vh",
